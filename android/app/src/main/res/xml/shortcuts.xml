<?xml version="1.0" encoding="utf-8"?>
<!-- Long-pressing the launcher icon starts a session directly. The PWA manifest had the
     same shortcut at /?screen=record; here it arrives as a contour://record URI, which
     App.tsx reads through the bridge's launch URL. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="record"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_record_short"
        android:shortcutLongLabel="@string/shortcut_record_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="contour://record"
            android:targetPackage="app.contour"
            android:targetClass="app.contour.MainActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
