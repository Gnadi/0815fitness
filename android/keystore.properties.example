# Copy to android/keystore.properties and fill in to build a signed release locally.
# The real file is gitignored, and so is the keystore it points at.
#
# Generate a key once, and keep it: an APK signed with a different key installs as a
# different app, which means uninstalling the old one, which means losing the log.
#
#   keytool -genkeypair -v -keystore contour-release.jks -alias contour \
#     -keyalg RSA -keysize 4096 -validity 10000
#
storeFile=contour-release.jks
storePassword=
keyAlias=contour
keyPassword=
