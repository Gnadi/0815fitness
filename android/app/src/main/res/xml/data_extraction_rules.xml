<?xml version="1.0" encoding="utf-8"?>
<!-- The log never leaves the device unless the person exports it. Cloud backup and
     device-to-device transfer are both refused rather than silently shipping a season
     of tracks to a Google account; Settings → Your data is the way off this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
