<?xml version="1.0" encoding="utf-8"?>
<!-- The app's own palette, from src/theme.ts. Contour is dark-only, so every window
     Android draws before or around the WebView uses the same ground the app does —
     otherwise the launch is a white flash and the navigation bar is a white bar under
     a black screen. -->
<resources>
    <color name="colorPrimary">#0B0C0D</color>
    <color name="colorPrimaryDark">#08090A</color>
    <color name="colorAccent">#8B84F7</color>
    <color name="ic_launcher_background">#0B0C0D</color>
    <color name="background">#0B0C0D</color>
</resources>
